# The access point IP assigned by the host installer.
AP_BIND_IP=192.168.50.1

# DISPLAY defaults to the active local X11-compatible desktop session.
DISPLAY=:0

# SDL window positions must match the extended desktop layout shown by xrandr.
# The defaults assume two 1920x1080 displays arranged side by side.
HDMI0_WINDOW_POS=0,0
HDMI1_WINDOW_POS=1920,0
